{
  "name": "duelo",
  "version": "1.0.0",
  "description": "Duelo — plateforme de quiz en duel dans le navigateur",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "seed": "node server/db/seed/index.js",
    "setup": "node scripts/setup.js",
    "backup": "bash deploy/backup.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.0.0",
    "jimp": "^1.6.1",
    "sharp": "^0.34.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  },
  "devDependencies": {
    "svgo": "^4.1.0"
  }
}
